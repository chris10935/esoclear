# Copy to .env.local (local) or add in Vercel > Project > Settings > Environment Variables.
# All values are public (NEXT_PUBLIC_*); never put secrets in this file.

# Canonical site URL (used for metadata, sitemap, robots, social cards).
NEXT_PUBLIC_SITE_URL=

# Approved public contact address. Required to enable the inquiry links and form.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: separate approved addresses for specific inquiry types.
# Each falls back to NEXT_PUBLIC_CONTACT_EMAIL when empty.
NEXT_PUBLIC_CONTACT_EMAIL_COLLABORATION=
NEXT_PUBLIC_CONTACT_EMAIL_RESEARCH=
